import React, { useState } from "react";
import { createRoot } from "react-dom/client";
import { Provider, useDispatch, useSelector } from "react-redux";
import { configureStore, createSlice } from "@reduxjs/toolkit";

// ---------------- Redux Slice ----------------
const cartSlice = createSlice({
  name: "cart",
  initialState: [],
  reducers: {
    addToCart: (state, action) => {
      const item = state.find(p => p.id === action.payload.id);
      if (!item) state.push({ ...action.payload, qty: 1 });
    },
    increase: (state, action) => {
      const item = state.find(p => p.id === action.payload);
      if (item) item.qty += 1;
    },
    decrease: (state, action) => {
      const item = state.find(p => p.id === action.payload);
      if (item && item.qty > 1) item.qty -= 1;
    },
    remove: (state, action) => {
      return state.filter(p => p.id !== action.payload);
    },
    clear: () => []
  }
});

const store = configureStore({ reducer: { cart: cartSlice.reducer } });
const { addToCart, increase, decrease, remove } = cartSlice.actions;

// ---------------- Data ----------------
const products = [
  { id: 1, name: "Rose Plant", price: 200, category: "Outdoor" },
  { id: 2, name: "Aloe Vera", price: 150, category: "Indoor" },
  { id: 3, name: "Tulsi", price: 100, category: "Herbal" },
  { id: 4, name: "Snake Plant", price: 250, category: "Indoor" },
  { id: 5, name: "Money Plant", price: 180, category: "Indoor" },
  { id: 6, name: "Neem Plant", price: 300, category: "Outdoor" }
];

// ---------------- Components ----------------
function Header({ setPage }) {
  const cart = useSelector(state => state.cart);
  const totalItems = cart.reduce((sum, p) => sum + p.qty, 0);

  return (
    <div style={styles.header}>
      <h2 style={{ cursor: "pointer" }} onClick={() => setPage("landing")}>🌱 GreenLife</h2>
      <div>
        <button onClick={() => setPage("products")} style={styles.navBtn}>Products</button>
        <button onClick={() => setPage("cart")} style={styles.navBtn}>
          🛒 Cart ({totalItems})
        </button>
      </div>
    </div>
  );
}

function Landing({ setPage }) {
  return (
    <div style={styles.landing}>
      <h1>Welcome to GreenLife 🌿</h1>
      <p>Your one-stop shop for fresh, beautiful, and healthy houseplants.</p>
      <button onClick={() => setPage("products")} style={styles.btn}>Get Started</button>
    </div>
  );
}

function Products() {
  const dispatch = useDispatch();
  const cart = useSelector(state => state.cart);

  return (
    <div style={styles.container}>
      <h2>Our Plants</h2>
      <div style={styles.grid}>
        {products.map(p => {
          const inCart = cart.find(item => item.id === p.id);
          return (
            <div key={p.id} style={styles.card}>
              <h3>{p.name}</h3>
              <p>₹{p.price}</p>
              <p style={{ fontSize: "12px", color: "gray" }}>{p.category}</p>
              <button
                onClick={() => dispatch(addToCart(p))}
                disabled={!!inCart}
                style={styles.btn}
              >
                {inCart ? "Added" : "Add to Cart"}
              </button>
            </div>
          );
        })}
      </div>
    </div>
  );
}

function Cart({ setPage }) {
  const cart = useSelector(state => state.cart);
  const dispatch = useDispatch();
  const totalQty = cart.reduce((sum, p) => sum + p.qty, 0);
  const totalCost = cart.reduce((sum, p) => sum + p.qty * p.price, 0);

  return (
    <div style={styles.container}>
      <h2>Shopping Cart</h2>
      {cart.length === 0 ? (
        <p>No items in cart.</p>
      ) : (
        <div>
          {cart.map(p => (
            <div key={p.id} style={styles.cartItem}>
              <h4>{p.name} (₹{p.price})</h4>
              <div>
                <button onClick={() => dispatch(decrease(p.id))} style={styles.smallBtn}>-</button>
                <span style={{ margin: "0 10px" }}>{p.qty}</span>
                <button onClick={() => dispatch(increase(p.id))} style={styles.smallBtn}>+</button>
                <button onClick={() => dispatch(remove(p.id))} style={styles.delBtn}>Delete</button>
              </div>
            </div>
          ))}
          <h3>Total Items: {totalQty}</h3>
          <h3>Total Cost: ₹{totalCost}</h3>
          <button onClick={() => alert("Coming Soon 🚀")} style={styles.btn}>Checkout</button>
          <button onClick={() => setPage("products")} style={styles.btn}>Continue Shopping</button>
        </div>
      )}
    </div>
  );
}

// ---------------- Main App ----------------
function App() {
  const [page, setPage] = useState("landing");

  return (
    <Provider store={store}>
      <Header setPage={setPage} />
      {page === "landing" && <Landing setPage={setPage} />}
      {page === "products" && <Products />}
      {page === "cart" && <Cart setPage={setPage} />}
    </Provider>
  );
}

// ---------------- Styles ----------------
const styles = {
  header: { display: "flex", justifyContent: "space-between", padding: "10px 20px", background: "#2e7d32", color: "white" },
  navBtn: { margin: "0 5px", padding: "6px 12px", background: "white", border: "none", borderRadius: "5px", cursor: "pointer" },
  landing: { textAlign: "center", padding: "50px", background: "url('https://www.transparenttextures.com/patterns/green-dust-and-scratches.png')", minHeight: "80vh" },
  btn: { padding: "8px 16px", margin: "5px", background: "#4caf50", color: "white", border: "none", borderRadius: "5px", cursor: "pointer" },
  container: { padding: "20px" },
  grid: { display: "grid", gridTemplateColumns: "repeat(auto-fit, minmax(200px, 1fr))", gap: "15px" },
  card: { border: "1px solid #ddd", borderRadius: "10px", padding: "15px", textAlign: "center", background: "#f9f9f9" },
  cartItem: { display: "flex", justifyContent: "space-between", alignItems: "center", borderBottom: "1px solid #ccc", padding: "10px 0" },
  smallBtn: { padding: "4px 10px", margin: "0 5px", background: "#81c784", border: "none", borderRadius: "4px", cursor: "pointer" },
  delBtn: { padding: "4px 10px", marginLeft: "10px", background: "red", color: "white", border: "none", borderRadius: "4px", cursor: "pointer" }
};

// ---------------- Render ----------------
const root = createRoot(document.getElementById("root"));
root.render(<App />);
